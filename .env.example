# ============================================================
# TruthLens Environment Variables (Template)
# Copy this file to .env before starting the application.
# Do NOT commit your actual .env file with secrets to git.
# ============================================================

# Serper Web Search API Key (Required for live web evidence search)
# Get a key at https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# MongoDB Connection URI (Default local MongoDB instance)
MONGODB_URI=mongodb://localhost:27017/truthlens

# Spring Boot Server Port
PORT=8080

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
